# Gmail SMTP (use a Google App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-email@gmail.com
MAIL_TO=your-email@gmail.com

# MongoDB Atlas connection string. Create a database user with a strong password,
# then allow only your server's IP address in Atlas Network Access.
MONGODB_URI=mongodb+srv://portfolio_user:replace-with-password@cluster0.example.mongodb.net/mulee_portfolio?retryWrites=true&w=majority
